<% layout('/layouts/boilerplate') %>
<h2 class="fw-bold mb-4">Your bookings</h2>
<% if (bookings.length) { %>
  <% bookings.forEach((booking) => { %>
    <div class="card mb-3 shadow-sm">
      <div class="card-body d-flex justify-content-between align-items-center">
        <div>
          <h5 class="mb-1"><%= booking.listing.title %></h5>
          <p class="mb-1 text-muted"><%= booking.checkIn.toDateString() %> - <%= booking.checkOut.toDateString() %></p>
          <p class="mb-0">Status: <span class="badge bg-warning text-dark"><%= booking.status %></span></p>
        </div>
        <div class="text-end">
          <p class="fw-semibold mb-2">₹<%= booking.totalPrice.toLocaleString('en-IN') %></p>
          <% if (booking.status !== 'Cancelled') { %>
            <form method="POST" action="/bookings/<%= booking._id %>/cancel">
              <button class="btn btn-outline-danger btn-sm">Cancel</button>
            </form>
          <% } %>
        </div>
      </div>
    </div>
  <% }) %>
<% } else { %>
  <p class="text-muted">No bookings yet.</p>
<% } %>
