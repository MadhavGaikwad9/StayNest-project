<% layout('/layouts/boilerplate') %>
<div class="row justify-content-center">
  <div class="col-lg-6">
    <div class="card shadow-sm p-4">
      <h3 class="fw-bold">Book <%= listing.title %></h3>
      <form method="POST" action="/bookings/<%= listing._id %>">
        <div class="row g-3 mt-2">
          <div class="col-md-6">
            <label class="form-label">Check in</label>
            <input name="booking[checkIn]" type="date" class="form-control" required />
          </div>
          <div class="col-md-6">
            <label class="form-label">Check out</label>
            <input name="booking[checkOut]" type="date" class="form-control" required />
          </div>
        </div>
        <div class="mt-3">
          <label class="form-label">Guests</label>
          <input name="booking[guests]" type="number" min="1" class="form-control" required />
        </div>
        <button class="btn btn-danger mt-4">Confirm booking</button>
      </form>
    </div>
  </div>
</div>
