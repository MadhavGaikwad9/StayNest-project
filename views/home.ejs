<% layout('/layouts/boilerplate') %>
<section class="hero-section py-5">
  <div class="row align-items-center g-5">
    <div class="col-lg-7">
      <p class="text-uppercase text-danger fw-semibold mb-2">StayNest Premium Rentals</p>
      <h1 class="display-4 fw-bold mb-3">Find your perfect stay</h1>
      <p class="lead text-muted">Discover curated homes, villas, and apartments for every trip in India and beyond.</p>
      <form class="row g-2 mt-4" action="/listings" method="GET">
        <div class="col-md-6">
          <input class="form-control form-control-lg" type="text" name="location" placeholder="Search by location" />
        </div>
        <div class="col-md-4">
          <select class="form-select form-select-lg" name="category">
            <option value="">Any category</option>
            <option>Beach</option>
            <option>Mountains</option>
            <option>Cities</option>
            <option>Luxury</option>
            <option>Camping</option>
            <option>Farms</option>
            <option>Rooms</option>
          </select>
        </div>
        <div class="col-md-2">
          <button class="btn btn-danger btn-lg w-100">Search</button>
        </div>
      </form>
    </div>
    <div class="col-lg-5">
      <img src="https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=900&q=80" class="img-fluid rounded-4 shadow" alt="Featured stay" />
    </div>
  </div>
</section>

<section class="py-4">
  <h3 class="fw-bold mb-3">Popular categories</h3>
  <div class="d-flex flex-wrap gap-2">
    <% ["Trending", "Beach", "Mountains", "Cities", "Luxury", "Camping", "Farms", "Rooms"].forEach((cat) => { %>
      <a href="/listings?category=<%= cat %>" class="btn btn-outline-dark rounded-pill"><%= cat %></a>
    <% }) %>
  </div>
</section>

<section class="py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold">Featured stays</h3>
    <a href="/listings" class="text-danger text-decoration-none">View all</a>
  </div>
  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    <% featuredListings.forEach((listing) => { %>
      <div class="col">
        <div class="card listing-card h-100 shadow-sm">
          <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>" />
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
              <h5 class="card-title mb-1"><%= listing.title %></h5>
              <span class="badge rounded-pill bg-light text-dark">★ 5.0</span>
            </div>
            <p class="text-muted small mb-2"><%= listing.location %>, <%= listing.country %></p>
            <p class="fw-semibold mb-2">₹<%= listing.price.toLocaleString("en-IN") %> / night</p>
            <a href="/listings/<%= listing._id %>" class="btn btn-outline-dark btn-sm">View details</a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</section>
