<% layout('/layouts/boilerplate') %>
<div class="row g-5">
  <div class="col-lg-7">
    <img src="<%= listing.image.url %>" class="img-fluid rounded-4 shadow" alt="<%= listing.title %>" />
  </div>
  <div class="col-lg-5">
    <span class="badge rounded-pill bg-danger-subtle text-danger"> <%= listing.category %></span>
    <h2 class="fw-bold mt-3"><%= listing.title %></h2>
    <p class="text-muted"><%= listing.location %>, <%= listing.country %></p>
    <p><%= listing.description %></p>
    <p class="fw-semibold fs-5">₹<%= listing.price.toLocaleString('en-IN') %> / night</p>
    <p class="text-muted">Average rating: <%= averageRating %> · <%= reviewCount %> reviews</p>
    <% if (currentUser && currentUser._id.toString() === listing.owner._id.toString()) { %>
      <div class="d-flex gap-2 mt-3">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">Edit</a>
        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
          <button class="btn btn-outline-danger">Delete</button>
        </form>
      </div>
    <% } %>
    <% if (currentUser) { %>
      <a href="/bookings/<%= listing._id %>/book" class="btn btn-danger mt-3">Book this stay</a>
    <% } else { %>
      <a href="/users/login" class="btn btn-danger mt-3">Login to book</a>
    <% } %>
  </div>
</div>

<hr class="my-5" />

<div class="row">
  <div class="col-lg-6">
    <h4 class="fw-bold">Leave a review</h4>
    <% if (currentUser) { %>
      <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation mt-3">
        <div class="mb-3">
          <label class="form-label">Rating</label>
          <input type="range" min="1" max="5" name="review[rating]" class="form-range" />
        </div>
        <div class="mb-3">
          <label class="form-label">Comment</label>
          <textarea name="review[comment]" class="form-control" rows="4" required></textarea>
        </div>
        <button class="btn btn-dark">Submit review</button>
      </form>
    <% } else { %>
      <p class="text-muted">Please login to add a review.</p>
    <% } %>
  </div>
  <div class="col-lg-6">
    <h4 class="fw-bold">Reviews</h4>
    <% if (listing.reviews.length) { %>
      <% listing.reviews.forEach((review) => { %>
        <div class="card mb-3">
          <div class="card-body">
            <div class="d-flex justify-content-between">
              <h6 class="card-title mb-0"><%= review.author.username %></h6>
              <span class="text-warning">★ <%= review.rating %></span>
            </div>
            <p class="card-text mt-2"><%= review.comment %></p>
            <% if (currentUser && review.author._id.toString() === currentUser._id.toString()) { %>
              <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                <button class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            <% } %>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <p class="text-muted">No reviews yet. Be the first to share your experience.</p>
    <% } %>
  </div>
</div>
